# homehunt settings. Copy to .env (git-ignored) and fill in values after "=" (no quotes):
#   cp .env.example .env

# --- Telegram (required for alerts) -------------------------------------------
# Bot token from @BotFather. Send /start to your bot once, then put your chat id here
# (or a channel/group id where the bot is a member).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web journal (optional) ----------------------------------------------------
# deploy/publish-web.sh copies the journal page over ssh after every poll.
# Empty HOMEHUNT_WEB_SSH = the page is only rendered locally to data/web/index.html.
HOMEHUNT_WEB_SSH=
HOMEHUNT_WEB_DIR=

# --- Overrides of config.yaml (optional) ----------------------------------------
# Any key in config.yaml can be overridden as HOMEHUNT__<SECTION>__<KEY>=<value>
# (the value is parsed as YAML: numbers, true/false, [lists], {maps}). Uncomment to use:
# HOMEHUNT__SEARCH__REGION=Austin, TX
# HOMEHUNT__SEARCH__MAX_RENT=1500
# HOMEHUNT__SEARCH__MIN_BEDS=2
# HOMEHUNT__SEARCH__IN_UNIT_LAUNDRY=true
# HOMEHUNT__SEARCH__BOUNDS={west: -80.36, east: -79.69, south: 40.19, north: 40.68}
# HOMEHUNT__SCORE__COST_BEST=1250
# HOMEHUNT__SCORE__COST_WORST=1850
# HOMEHUNT__SCORE__WEIGHTS={cost: 50, safety: 12, parking: 12, income: 8, type: 7, baths: 6}
# HOMEHUNT__POLL__INTERVAL_MIN=15
# HOMEHUNT__POLL__MAX_DETAILS_PER_RUN=12
# HOMEHUNT__POLL__DETAIL_DELAY_S=[2, 5]
# HOMEHUNT__NOTIFY__MIN_SCORE=55
# HOMEHUNT__NOTIFY__MIN_RELIABILITY=60
# HOMEHUNT__NOTIFY__MIN_VALUE=60
# HOMEHUNT__NOTIFY__PRICE_DROP_MIN_USD=200
# HOMEHUNT__NOTIFY__PRICE_DROP_MIN_PCT=5
# HOMEHUNT__AI__TRIAGE_MODEL=haiku
# HOMEHUNT__AI__JUDGE_MODEL=opus
# HOMEHUNT__AI__MAX_PHOTOS=8
# HOMEHUNT__AI__TIMEOUT_S=240
# HOMEHUNT__HEALTH__FAIL_RUNS_BEFORE_ALERT=2
# HOMEHUNT__REPORT__TIMEZONE=America/Los_Angeles
